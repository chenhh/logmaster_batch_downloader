import { Button, LineEdit, ComboBox, ProgressIndicator, ScrollView, GroupBox } from "std-widgets.slint";

export component LogMasterUI inherits Window {
    title: "logmaster錄音備份程式";
    icon: @image-url("icons/tpc.png");
    min-width: 680px;
    max-width: 680px;
    min-height: 640px;
    max-height: 640px;

    in-out property <string> host-url: "http://192.168.1.100";
    in-out property <string> username: "admin";
    in-out property <string> password: "123";
    in-out property <string> status-text: "未連線";
    in-out property <color> status-color: #888888;
    in-out property <string> current-year: "2024";
    in-out property <string> current-month: "10";
    in-out property <[string]> years: ["2021", "2022", "2023", "2024", "2025", "2026"];
    in-out property <[string]> months: ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"];
    in-out property <string> output-path: "";
    in-out property <bool> is-downloading: false;
    in-out property <float> download-progress: 0.0;
    in-out property <string> progress-label: "0 / 0 (0%)";
    in-out property <string> current-file-label: "";
    in-out property <string> log-content: "";

    callback test-connection();
    callback browse-folder();
    callback start-download();
    callback cancel-download();
    callback clear-log();

    about_popup := PopupWindow {
        x: 150px;
        y: 200px;
        width: 380px;
        height: 180px;
        close-on-click: true;

        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000044;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: "關於我";
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Vibe coding, made by Gemini 3.8, Nanpu Power Plant";
                    font-size: 13px;
                    color: #333333;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    Button {
                        text: "確定";
                        primary: true;
                        width: 80px;
                        clicked => { about_popup.close(); }
                    }
                }
            }
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // Header bar
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "logmaster 錄音備份程式";
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Button {
                text: "關於我";
                clicked => { about_popup.show(); }
            }
        }

        // Group 1: 伺服器連線設定
        GroupBox {
            title: "伺服器連線設定";
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "主機位址:";
                        vertical-alignment: center;
                    }
                    host_input := LineEdit {
                        text <=> root.host-url;
                        enabled: !root.is-downloading;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "測試連線";
                        enabled: !root.is-downloading;
                        clicked => { root.test-connection(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "帳號:";
                        vertical-alignment: center;
                    }
                    user_input := LineEdit {
                        text <=> root.username;
                        enabled: !root.is-downloading;
                        width: 100px;
                    }
                    Text {
                        text: "密碼:";
                        vertical-alignment: center;
                    }
                    pwd_input := LineEdit {
                        text <=> root.password;
                        input-type: InputType.password;
                        enabled: !root.is-downloading;
                        width: 100px;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text {
                            text: "狀態:";
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.status-text;
                            color: root.status-color;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // Group 2: 下載條件與儲存目錄
        GroupBox {
            title: "下載條件與儲存目錄";
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "年份:";
                        vertical-alignment: center;
                    }
                    year_combo := ComboBox {
                        model: root.years;
                        current-value <=> root.current-year;
                        enabled: !root.is-downloading;
                        width: 90px;
                    }
                    Text {
                        text: "月份:";
                        vertical-alignment: center;
                    }
                    month_combo := ComboBox {
                        model: root.months;
                        current-value <=> root.current-month;
                        enabled: !root.is-downloading;
                        width: 70px;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "儲存目錄:";
                        vertical-alignment: center;
                    }
                    path_input := LineEdit {
                        text <=> root.output-path;
                        enabled: !root.is-downloading;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "瀏覽...";
                        enabled: !root.is-downloading;
                        clicked => { root.browse-folder(); }
                    }
                }
            }
        }

        // Group 3: 下載操作與進度監控
        GroupBox {
            title: "下載操作與進度監控";
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    Button {
                        text: "開始下載";
                        primary: true;
                        enabled: !root.is-downloading;
                        clicked => { root.start-download(); }
                    }
                    Button {
                        text: "停止下載";
                        enabled: root.is-downloading;
                        clicked => { root.cancel-download(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.progress-label;
                        vertical-alignment: center;
                        font-weight: 700;
                    }
                }
                ProgressIndicator {
                    progress: root.download-progress;
                }
                HorizontalLayout {
                    Text {
                        text: root.current-file-label;
                        color: #555555;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }
        }

        // Group 4: 執行日誌
        GroupBox {
            title: "執行日誌";
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "清除日誌";
                        clicked => { root.clear-log(); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    min-height: 120px;
                    Text {
                        text: root.log-content;
                        wrap: word-wrap;
                        font-size: 12px;
                    }
                }
            }
        }
    }
}
